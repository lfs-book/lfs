<sect1 id="ch-system-sqlite" role="wrap">
  <?dbhtml filename="sqlite.html"?>

  <sect1info condition="script">
    <productname>sqlite</productname>
    <productnumber>&sqlite-version;</productnumber>
    <address>&sqlite-url;</address>
