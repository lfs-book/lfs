<sect1 id="ch-system-cmake" role="wrap">
  <?dbhtml filename="cmake.html"?>

  <sect1info condition="script">
    <productname>cmake</productname>
    <productnumber>&cmake-version;</productnumber>
    <address>&cmake-url;</address>
